PYTHONUNBUFFERED=1
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8765
DEVICE_NAME=AI Limits
ACCESS_TOKEN=

CODEX_ENABLED=true
CODEX_PATH=codex
CODEX_TIMEOUT_SECONDS=10

CLAUDE_ENABLED=false
CLAUDE_BASE_URL=https://claude.ai
CLAUDE_SESSION_KEY=
CLAUDE_TIMEOUT_SECONDS=15

GEMINI_ENABLED=false
# Path to credentials file produced by gemini-creds-setup.py
GEMINI_CREDS_FILE=
# Optional: path to history.jsonl for usage percentages (default: ~/.gemini/antigravity-cli/history.jsonl)
GEMINI_HISTORY_FILE=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_DAILY_LIMIT=1000
GEMINI_RPM_LIMIT=15
GEMINI_TIMEOUT_SECONDS=15
